{
  "shk-security": {
    "PostToolUse": [
      {
        "_shk_managed": true,
        "hooks": [
          {
            "command": "shk scan --hook-mode antigravity --log-blocked --post",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "_shk_managed": true,
        "hooks": [
          {
            "command": "shk scan --hook-mode antigravity --log-blocked",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
