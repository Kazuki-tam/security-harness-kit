{
  "hooks": {
    "afterMCPExecution": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked --post",
        "timeout": 30
      }
    ],
    "afterShellExecution": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked --post",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "_shk_managed": true,
        "command": "shk scan --hook-mode cursor --log-blocked --fail-on medium",
        "failClosed": false,
        "timeout": 30
      }
    ]
  },
  "version": 1
}
