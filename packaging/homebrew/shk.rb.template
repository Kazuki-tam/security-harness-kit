class Shk < Formula
  desc "Local-first security harness for AI-assisted development"
  homepage "https://github.com/Kazuki-tam/security-harness-kit"
  version "{{version}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/Kazuki-tam/security-harness-kit/releases/download/v{{version}}/shk-aarch64-apple-darwin.tar.gz"
      sha256 "{{sha256_aarch64_apple_darwin}}"
    else
      url "https://github.com/Kazuki-tam/security-harness-kit/releases/download/v{{version}}/shk-x86_64-apple-darwin.tar.gz"
      sha256 "{{sha256_x86_64_apple_darwin}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/Kazuki-tam/security-harness-kit/releases/download/v{{version}}/shk-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "{{sha256_aarch64_unknown_linux_gnu}}"
    else
      url "https://github.com/Kazuki-tam/security-harness-kit/releases/download/v{{version}}/shk-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{sha256_x86_64_unknown_linux_gnu}}"
    end
  end

  def install
    pkg_dir = Pathname.glob("shk-*").find(&:directory?)
    bin.install pkg_dir/"shk"
    bin.install pkg_dir/"security-harness-kit"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/shk --version")
  end
end
