{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "properties": {
        "deduplicated": 0,
        "exitThreshold": "high",
        "scannedPaths": [
          "insecure-sample.txt"
        ],
        "suppressed": 0
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "insecure-sample.txt"
                },
                "region": {
                  "startColumn": 15,
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "Possible OpenAI API key detected"
          },
          "properties": {
            "confidence": 0.8999999761581421,
            "kind": "secret",
            "redactedValue": "[REDACTED]",
            "severity": "high"
          },
          "ruleId": "secret.openai_api_key"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/Kazuki-tam/security-harness-kit",
          "name": "shk",
          "rules": [
            {
              "id": "secret.openai_api_key",
              "name": "secret.openai_api_key",
              "properties": {
                "kind": "secret",
                "precision": "high",
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "secret"
                ]
              },
              "shortDescription": {
                "text": "Possible OpenAI API key detected"
              }
            }
          ],
          "semanticVersion": "<version>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
