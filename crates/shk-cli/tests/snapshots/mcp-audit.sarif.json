{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "properties": {
        "configFiles": [
          ".mcp.json"
        ],
        "exitThreshold": "high",
        "servers": [
          {
            "client": "claude-code",
            "name": "filesystem",
            "source_file": ".mcp.json",
            "transport": "stdio"
          },
          {
            "client": "claude-code",
            "name": "pinned",
            "source_file": ".mcp.json",
            "transport": "stdio"
          }
        ]
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".mcp.json"
                },
                "region": {
                  "startColumn": 1,
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "filesystem root is exposed; MCP server \"filesystem\" (claude-code)"
          },
          "properties": {
            "confidence": 1.0,
            "kind": "mcp",
            "redactedValue": "[REDACTED]",
            "severity": "high"
          },
          "ruleId": "mcp.broad_filesystem_scope"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/Kazuki-tam/security-harness-kit",
          "name": "shk",
          "rules": [
            {
              "id": "mcp.broad_filesystem_scope",
              "name": "mcp.broad_filesystem_scope",
              "properties": {
                "kind": "mcp",
                "precision": "high",
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp"
                ]
              },
              "shortDescription": {
                "text": "filesystem root is exposed; MCP server \"filesystem\" (claude-code)"
              }
            }
          ],
          "semanticVersion": "<version>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
